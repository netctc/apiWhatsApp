NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/api_whatsapp?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Tenant API authentication
# Use a random secret with at least 32 bytes in production.
API_KEY_HASH_SECRET=replace-with-a-long-random-secret

# Operational health and metrics
# Maximum time allowed for each PostgreSQL, Redis, and RabbitMQ readiness probe.
HEALTH_DEPENDENCY_TIMEOUT_MS=1500
# Separate monitoring credential for GET /api/metrics. Minimum 32 characters.
# Keep blank to disable the endpoint. Do not reuse a tenant API key or Meta access token.
METRICS_BEARER_TOKEN=

# Meta WhatsApp Cloud API
# Graph version and webhook credentials are application-level configuration.
META_GRAPH_API_VERSION=vXX.X
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_HTTP_TIMEOUT_MS=15000
# Media upload can involve files up to the documented Meta media limits, so it has a separate bounded timeout.
# Allowed range: 1000-600000 ms.
META_MEDIA_UPLOAD_TIMEOUT_MS=120000
# Testing seam only. Leave unset in normal environments so https://graph.facebook.com is used.
# HTTP overrides are rejected unless NODE_ENV=test; HTTPS overrides remain suitable for controlled test/staging proxies.
# META_GRAPH_API_BASE_URL=https://graph.example.test

# Optional media malware scanning
# disabled: preserve the existing direct-to-Meta upload path.
# clamav: stream every accepted upload through a clamd INSTREAM scan before sender credentials/provider access.
# When clamav is selected, any scanner connection/protocol/configuration failure fails the upload closed with HTTP 503.
MEDIA_MALWARE_SCAN_MODE=disabled
MEDIA_CLAMAV_HOST=127.0.0.1
MEDIA_CLAMAV_PORT=3310
# Allowed range: 1000-600000 ms.
MEDIA_CLAMAV_TIMEOUT_MS=120000

# Media asset registry
# Local registry lifecycle horizon only; this does not claim or alter Meta provider retention semantics.
# Allowed range: 1-3650 whole days. Invalid values fail uploads before provider access.
MEDIA_ASSET_TTL_DAYS=30

# Legacy sender fallback
# These values are only needed for pre-0.3 queued messages that do not have a persisted senderId.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Tenant sender secrets
# Register each sender through POST /api/v1/phone-numbers with credentialRef="env:VARIABLE_NAME".
# The referenced environment variable contains the raw Meta access token and is never stored in PostgreSQL.
# META_ACME_WHATSAPP_TOKEN=

# Outbound messaging
OUTBOUND_QUEUE_NAME=whatsapp.outbound
# OUTBOUND_WORKER_PREFETCH remains the TRANSACTIONAL fallback for backward compatibility.
OUTBOUND_WORKER_PREFETCH=20
OUTBOUND_WORKER_PREFETCH_OTP=10
OUTBOUND_WORKER_PREFETCH_TRANSACTIONAL=20
OUTBOUND_WORKER_PREFETCH_MARKETING=5
OUTBOUND_RETRY_DELAYS_MS=5000,30000,120000,600000
OUTBOUND_MESSAGE_LEASE_MS=30000
DEFAULT_OUTBOUND_RATE_LIMIT_PER_SECOND=75

# Priority-aware sender capacity reservation
# During the first N ms of each one-second rate window, lower classes are capped to preserve OTP headroom.
# During the remainder of the second, unused capacity can be borrowed by any class.
OUTBOUND_PRIORITY_RESERVATION_WINDOW_MS=700
OUTBOUND_TRANSACTIONAL_MAX_SHARE=0.60
OUTBOUND_MARKETING_MAX_SHARE=0.20

# Transactional outbox
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000

# Campaign orchestration
# Foundation release hard-caps snapshots at 50,000 recipients even if a larger value is configured.
CAMPAIGN_MAX_RECIPIENTS=50000
CAMPAIGN_PROCESSOR_INTERVAL_MS=500
CAMPAIGN_PROCESSOR_BATCH_SIZE=100
CAMPAIGN_PROCESSOR_LEASE_MS=30000
CAMPAIGN_RECIPIENT_MAX_ATTEMPTS=5

# Webhook processing
WEBHOOK_PROCESSOR_INTERVAL_MS=500
WEBHOOK_PROCESSOR_BATCH_SIZE=50
WEBHOOK_PROCESSOR_LEASE_MS=30000
