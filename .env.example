NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/api_whatsapp?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Meta WhatsApp Cloud API
META_GRAPH_API_VERSION=vXX.X
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_HTTP_TIMEOUT_MS=15000

# Outbound messaging
OUTBOUND_QUEUE_NAME=whatsapp.outbound
OUTBOUND_WORKER_PREFETCH=20
OUTBOUND_RETRY_DELAYS_MS=5000,30000,120000,600000
OUTBOUND_MESSAGE_LEASE_MS=30000
DEFAULT_OUTBOUND_RATE_LIMIT_PER_SECOND=75

# Transactional outbox
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000

# Webhook processing
WEBHOOK_PROCESSOR_INTERVAL_MS=500
WEBHOOK_PROCESSOR_BATCH_SIZE=50
WEBHOOK_PROCESSOR_LEASE_MS=30000
