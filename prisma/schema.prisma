generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum WhatsAppChannelStatus {
  ACTIVE
  DISABLED
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
  REVOKED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  CREATED
  QUEUED
  PROCESSING
  SUBMITTED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
  EXPIRED
}

enum MessageType {
  TEXT
  TEMPLATE
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  INTERACTIVE
  LOCATION
  CONTACT
}

model Tenant {
  id            String                @id @default(uuid()) @db.Uuid
  name          String                @db.VarChar(160)
  slug          String                @unique @db.VarChar(80)
  status        TenantStatus          @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  apiKeys       ApiKey[]
  channels      WhatsAppChannel[]
  contacts      Contact[]
  consentEvents ContactConsentEvent[]
  messages      Message[]
}

model ApiKey {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  name       String   @db.VarChar(120)
  keyPrefix  String   @unique @db.VarChar(24)
  keyHash    String   @unique @db.Char(64)
  scopes     String[] @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, revokedAt, expiresAt])
}

model WhatsAppChannel {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @db.Uuid
  name                  String                @db.VarChar(120)
  providerPhoneNumberId String                @unique @db.VarChar(64)
  wabaId                String                @db.VarChar(64)
  displayPhoneNumber    String?               @db.VarChar(32)
  verifiedName          String?               @db.VarChar(160)
  status                WhatsAppChannelStatus @default(ACTIVE)
  isDefault             Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages              Message[]

  @@index([tenantId, status, isDefault])
}

model Contact {
  id                           String               @id @default(uuid()) @db.Uuid
  tenantId                     String               @db.Uuid
  phoneNumber                  String               @db.VarChar(32)
  name                         String?              @db.VarChar(160)
  language                     String?              @db.VarChar(20)
  timezone                     String?              @db.VarChar(80)
  metadata                     Json?
  optInStatus                  ConsentStatus        @default(UNKNOWN)
  optInUpdatedAt               DateTime?
  customerServiceWindowExpiresAt DateTime?
  lastInboundAt                DateTime?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  tenant                       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consentEvents                ContactConsentEvent[]
  messages                     Message[]

  @@unique([tenantId, phoneNumber])
  @@index([tenantId, optInStatus, updatedAt])
  @@index([tenantId, customerServiceWindowExpiresAt])
}

model ContactConsentEvent {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  contactId     String        @db.Uuid
  status        ConsentStatus
  source        String        @db.VarChar(100)
  evidence      Json?
  policyVersion String?       @db.VarChar(50)
  occurredAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact       Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId, occurredAt])
}

model Message {
  id                   String           @id @default(uuid()) @db.Uuid
  tenantId             String?          @db.Uuid
  channelId            String?          @db.Uuid
  contactId            String?          @db.Uuid
  direction            MessageDirection
  type                 MessageType
  status               MessageStatus    @default(CREATED)
  to                   String?
  from                 String?
  providerMessageId    String?          @unique
  idempotencyKey       String?
  payload              Json
  providerResponse     Json?
  errorCode            String?
  errorMessage         String?
  attemptCount         Int              @default(0)
  lastAttemptAt        DateTime?
  processingLeaseUntil DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  submittedAt          DateTime?
  sentAt               DateTime?
  deliveredAt          DateTime?
  readAt               DateTime?
  failedAt             DateTime?
  tenant               Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  channel              WhatsAppChannel? @relation(fields: [channelId], references: [id], onDelete: Restrict)
  contact              Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  statusEvents         MessageStatusEvent[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([channelId, createdAt])
  @@index([contactId, createdAt])
  @@index([status, processingLeaseUntil, createdAt])
  @@index([to, createdAt])
}

model MessageStatusEvent {
  id        String        @id @default(uuid()) @db.Uuid
  messageId String        @db.Uuid
  status    MessageStatus
  payload   Json?
  createdAt DateTime      @default(now())
  message   Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

model WebhookEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  providerEventId      String?  @unique
  payload              Json
  processed            Boolean  @default(false)
  attemptCount         Int      @default(0)
  nextAttemptAt        DateTime @default(now())
  processingLeaseUntil DateTime?
  lastError            String?
  receivedAt           DateTime @default(now())
  processedAt          DateTime?

  @@index([processed, nextAttemptAt, processingLeaseUntil, receivedAt])
}

model OutboxEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  aggregateType        String
  aggregateId          String   @db.Uuid
  eventType            String
  payload              Json
  attempts             Int      @default(0)
  nextAttemptAt        DateTime @default(now())
  processingLeaseUntil DateTime?
  lastError            String?
  publishedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([publishedAt, nextAttemptAt, processingLeaseUntil, createdAt])
  @@index([aggregateType, aggregateId])
}
