generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageTrafficClass {
  OTP
  TRANSACTIONAL
  MARKETING
}

enum MessageStatus {
  CREATED
  RECEIVED
  QUEUED
  PROCESSING
  SUBMITTED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
  EXPIRED
}

enum MessageType {
  TEXT
  TEMPLATE
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  INTERACTIVE
  LOCATION
  CONTACT
  UNKNOWN
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  PROCESSING
  QUEUED
  SKIPPED
  FAILED
  CANCELLED
}

model Tenant {
  id           String                @id @default(uuid()) @db.Uuid
  name         String
  slug         String                @unique
  status       TenantStatus          @default(ACTIVE)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  apiKeys      ApiKey[]
  contacts     Contact[]
  messages     Message[]
  consents     ContactConsentEvent[]
  phoneNumbers WhatsAppPhoneNumber[]
  templates    MessageTemplate[]
  campaigns    Campaign[]
  auditLogs    AuditLog[]
}

model ApiKey {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @db.Uuid
  name       String
  prefix     String
  keyHash    String     @unique
  scopes     String[]
  active     Boolean    @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime   @default(now())
  revokedAt  DateTime?
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs  AuditLog[] @relation("AuditActorApiKey")

  @@index([tenantId, active])
  @@index([prefix])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  actorApiKeyId String?  @db.Uuid
  action        String
  entityType    String
  entityId      String?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorApiKey   ApiKey?  @relation("AuditActorApiKey", fields: [actorApiKeyId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([tenantId, entityType, entityId, createdAt])
}

model WhatsAppPhoneNumber {
  id                    String     @id @default(uuid()) @db.Uuid
  tenantId              String     @db.Uuid
  providerPhoneNumberId String     @unique
  wabaId                 String?
  displayPhoneNumber     String?
  verifiedName           String?
  credentialRef          String
  rateLimitPerSecond     Int?
  active                 Boolean    @default(true)
  isDefault              Boolean    @default(false)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  tenant                 Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages               Message[]
  campaigns              Campaign[]

  @@index([tenantId, active, isDefault])
  @@index([tenantId, wabaId, active])
  @@index([wabaId, tenantId])
}

model MessageTemplate {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @db.Uuid
  wabaId              String
  providerTemplateId String     @unique
  name                String
  language            String
  category            String?
  status              String
  components          Json?
  qualityScore        Json?
  rejectionReason     String?
  providerPayload     Json?
  lastSyncedAt        DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns           Campaign[]

  @@unique([tenantId, wabaId, name, language])
  @@index([tenantId, wabaId, status, name])
  @@index([tenantId, updatedAt])
}

model Contact {
  id                     String              @id @default(uuid()) @db.Uuid
  tenantId               String              @db.Uuid
  phone                  String
  name                   String?
  language               String?
  timezone               String?
  tags                   String[]            @default([])
  consentStatus          ConsentStatus       @default(UNKNOWN)
  consentSource          String?
  consentAt              DateTime?
  optedOutAt             DateTime?
  lastInboundAt          DateTime?
  serviceWindowExpiresAt DateTime?
  metadata               Json?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consentEvents          ContactConsentEvent[]
  campaignRecipients     CampaignRecipient[]

  @@unique([tenantId, phone])
  @@index([tenantId, consentStatus, createdAt])
  @@index([tenantId, serviceWindowExpiresAt])
  @@index([tags], type: Gin)
}

model ContactConsentEvent {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @db.Uuid
  contactId  String        @db.Uuid
  status     ConsentStatus
  source     String
  evidence   Json?
  occurredAt DateTime      @default(now())
  createdAt  DateTime      @default(now())
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact    Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId, occurredAt])
}

model Campaign {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @db.Uuid
  senderId            String              @db.Uuid
  templateId          String              @db.Uuid
  name                String
  status              CampaignStatus      @default(DRAFT)
  audience            Json
  components          Json?
  scheduledAt         DateTime?
  snapshotAt          DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  failureReason       String?
  totalRecipients     Int                 @default(0)
  queuedRecipients    Int                 @default(0)
  skippedRecipients   Int                 @default(0)
  failedRecipients    Int                 @default(0)
  cancelledRecipients Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender              WhatsAppPhoneNumber @relation(fields: [senderId], references: [id], onDelete: Restrict)
  template            MessageTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  recipients          CampaignRecipient[]

  @@index([tenantId, status, scheduledAt, createdAt])
  @@index([status, scheduledAt])
  @@index([tenantId, createdAt])
  @@index([senderId, status])
  @@index([templateId, status])
}

model CampaignRecipient {
  id                   String                  @id @default(uuid()) @db.Uuid
  campaignId           String                  @db.Uuid
  contactId            String                  @db.Uuid
  messageId            String?                 @unique @db.Uuid
  status               CampaignRecipientStatus @default(PENDING)
  attemptCount         Int                     @default(0)
  nextAttemptAt        DateTime                @default(now())
  processingLeaseUntil DateTime?
  lastError            String?
  queuedAt             DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  campaign             Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact              Contact                 @relation(fields: [contactId], references: [id], onDelete: Restrict)
  message              Message?                @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([campaignId, contactId])
  @@index([campaignId, status, nextAttemptAt, processingLeaseUntil, createdAt])
  @@index([status, nextAttemptAt, processingLeaseUntil, createdAt])
  @@index([contactId, createdAt])
}

model Message {
  id                   String                 @id @default(uuid()) @db.Uuid
  tenantId             String?                @db.Uuid
  senderId             String?                @db.Uuid
  direction            MessageDirection
  trafficClass         MessageTrafficClass    @default(TRANSACTIONAL)
  type                 MessageType
  status               MessageStatus          @default(CREATED)
  to                   String?
  from                 String?
  providerMessageId    String?                @unique
  providerTimestamp    DateTime?
  idempotencyKey       String?
  payload              Json
  providerResponse     Json?
  errorCode            String?
  errorMessage         String?
  attemptCount         Int                    @default(0)
  lastAttemptAt        DateTime?
  processingLeaseUntil DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  submittedAt          DateTime?
  sentAt               DateTime?
  deliveredAt          DateTime?
  readAt               DateTime?
  failedAt             DateTime?
  tenant               Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sender               WhatsAppPhoneNumber?   @relation(fields: [senderId], references: [id], onDelete: Restrict)
  statusEvents         MessageStatusEvent[]
  campaignRecipient    CampaignRecipient?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, senderId, createdAt])
  @@index([tenantId, trafficClass, createdAt])
  @@index([trafficClass, status, processingLeaseUntil, createdAt])
  @@index([status, processingLeaseUntil, createdAt])
  @@index([to, createdAt])
}

model MessageStatusEvent {
  id        String        @id @default(uuid()) @db.Uuid
  messageId String        @db.Uuid
  status    MessageStatus
  payload   Json?
  createdAt DateTime      @default(now())
  message   Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

model WebhookEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  providerEventId      String?  @unique
  payload              Json
  processed            Boolean  @default(false)
  attemptCount         Int      @default(0)
  nextAttemptAt        DateTime @default(now())
  processingLeaseUntil DateTime?
  lastError            String?
  receivedAt           DateTime @default(now())
  processedAt          DateTime?

  @@index([processed, nextAttemptAt, processingLeaseUntil, receivedAt])
}

model OutboxEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  aggregateType        String
  aggregateId          String   @db.Uuid
  eventType            String
  payload              Json
  attempts             Int      @default(0)
  nextAttemptAt        DateTime @default(now())
  processingLeaseUntil DateTime?
  lastError            String?
  publishedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([publishedAt, nextAttemptAt, processingLeaseUntil, createdAt])
  @@index([aggregateType, aggregateId])
}
