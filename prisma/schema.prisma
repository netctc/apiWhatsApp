generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  CREATED
  QUEUED
  PROCESSING
  SUBMITTED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
  EXPIRED
}

enum MessageType {
  TEXT
  TEMPLATE
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  INTERACTIVE
  LOCATION
  CONTACT
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(160)
  slug      String       @unique @db.VarChar(80)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  apiKeys   ApiKey[]
  messages  Message[]
}

model ApiKey {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  name       String   @db.VarChar(120)
  keyPrefix  String   @unique @db.VarChar(24)
  keyHash    String   @unique @db.Char(64)
  scopes     String[] @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, revokedAt, expiresAt])
}

model Message {
  id                   String           @id @default(uuid()) @db.Uuid
  tenantId             String?          @db.Uuid
  direction            MessageDirection
  type                 MessageType
  status               MessageStatus    @default(CREATED)
  to                   String?
  from                 String?
  providerMessageId    String?          @unique
  idempotencyKey       String?
  payload              Json
  providerResponse     Json?
  errorCode            String?
  errorMessage         String?
  attemptCount         Int              @default(0)
  lastAttemptAt        DateTime?
  processingLeaseUntil DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  submittedAt          DateTime?
  sentAt               DateTime?
  deliveredAt          DateTime?
  readAt               DateTime?
  failedAt             DateTime?
  tenant               Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  statusEvents         MessageStatusEvent[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([status, processingLeaseUntil, createdAt])
  @@index([to, createdAt])
}

model MessageStatusEvent {
  id        String        @id @default(uuid()) @db.Uuid
  messageId String        @db.Uuid
  status    MessageStatus
  payload   Json?
  createdAt DateTime      @default(now())
  message   Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

model WebhookEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  providerEventId      String?  @unique
  payload              Json
  processed            Boolean  @default(false)
  attemptCount         Int      @default(0)
  nextAttemptAt        DateTime @default(now())
  processingLeaseUntil DateTime?
  lastError            String?
  receivedAt           DateTime @default(now())
  processedAt          DateTime?

  @@index([processed, nextAttemptAt, processingLeaseUntil, receivedAt])
}

model OutboxEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  aggregateType        String
  aggregateId          String   @db.Uuid
  eventType            String
  payload              Json
  attempts             Int      @default(0)
  nextAttemptAt        DateTime @default(now())
  processingLeaseUntil DateTime?
  lastError            String?
  publishedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([publishedAt, nextAttemptAt, processingLeaseUntil, createdAt])
  @@index([aggregateType, aggregateId])
}
