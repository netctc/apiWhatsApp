generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  CREATED
  QUEUED
  PROCESSING
  SUBMITTED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
  EXPIRED
}

enum MessageType {
  TEXT
  TEMPLATE
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  INTERACTIVE
  LOCATION
  CONTACT
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  apiKeys   ApiKey[]
  contacts  Contact[]
  messages  Message[]
  consents  ContactConsentEvent[]
}

model ApiKey {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  name       String
  prefix     String
  keyHash    String   @unique
  scopes     String[]
  active     Boolean  @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  revokedAt  DateTime?
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@index([prefix])
}

model Contact {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  phone         String
  name          String?
  language      String?
  timezone      String?
  consentStatus ConsentStatus @default(UNKNOWN)
  consentSource String?
  consentAt     DateTime?
  optedOutAt    DateTime?
  lastInboundAt DateTime?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consentEvents ContactConsentEvent[]

  @@unique([tenantId, phone])
  @@index([tenantId, consentStatus, createdAt])
}

model ContactConsentEvent {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @db.Uuid
  contactId  String        @db.Uuid
  status     ConsentStatus
  source     String
  evidence   Json?
  occurredAt DateTime      @default(now())
  createdAt  DateTime      @default(now())
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact    Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId, occurredAt])
}

model Message {
  id                   String           @id @default(uuid()) @db.Uuid
  tenantId             String?          @db.Uuid
  direction            MessageDirection
  type                 MessageType
  status               MessageStatus    @default(CREATED)
  to                   String?
  from                 String?
  providerMessageId    String?          @unique
  idempotencyKey       String?
  payload              Json
  providerResponse     Json?
  errorCode            String?
  errorMessage         String?
  attemptCount         Int              @default(0)
  lastAttemptAt        DateTime?
  processingLeaseUntil DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  submittedAt          DateTime?
  sentAt               DateTime?
  deliveredAt          DateTime?
  readAt               DateTime?
  failedAt             DateTime?
  tenant               Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  statusEvents         MessageStatusEvent[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([status, processingLeaseUntil, createdAt])
  @@index([to, createdAt])
}

model MessageStatusEvent {
  id        String        @id @default(uuid()) @db.Uuid
  messageId String        @db.Uuid
  status    MessageStatus
  payload   Json?
  createdAt DateTime      @default(now())
  message   Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

model WebhookEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  providerEventId      String?  @unique
  payload              Json
  processed            Boolean  @default(false)
  attemptCount         Int      @default(0)
  nextAttemptAt        DateTime @default(now())
  processingLeaseUntil DateTime?
  lastError            String?
  receivedAt           DateTime @default(now())
  processedAt          DateTime?

  @@index([processed, nextAttemptAt, processingLeaseUntil, receivedAt])
}

model OutboxEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  aggregateType        String
  aggregateId          String   @db.Uuid
  eventType            String
  payload              Json
  attempts             Int      @default(0)
  nextAttemptAt        DateTime @default(now())
  processingLeaseUntil DateTime?
  lastError            String?
  publishedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([publishedAt, nextAttemptAt, processingLeaseUntil, createdAt])
  @@index([aggregateType, aggregateId])
}
